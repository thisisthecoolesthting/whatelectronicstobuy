.mre-conversion-panel,.mre-software-tools{margin:2.5rem auto;padding:1.25rem;border:1px solid rgba(15,23,42,.14);border-radius:12px;background:rgba(255,255,255,.94);color:#0f172a;max-width:1120px}
.mre-conversion-panel h2,.mre-software-tools h2{font-size:clamp(1.25rem,2vw,1.75rem);line-height:1.2;margin:0 0 .75rem;color:#0f172a}
.mre-answer{padding:1rem;border-radius:10px;background:#f8fafc;margin-bottom:1rem}
.mre-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.9fr);gap:1rem}
.mre-shortlist{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:.7rem;list-style:none;padding:0;margin:.75rem 0 0}
.mre-shortlist a,.mre-tools a{display:block;border:1px solid #dbe3ea;border-radius:8px;padding:.7rem;background:#fff;color:#0f3f6e;font-weight:700;text-decoration:none}
.mre-shortlist small,.mre-tools small{display:block;color:#64748b;font-weight:500;margin-top:.25rem}
.mre-lead form{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.75rem}
.mre-lead input{flex:1 1 210px;min-width:0;border:1px solid #cbd5e1;border-radius:8px;padding:.7rem;font:inherit;color:#0f172a;background:#fff}
